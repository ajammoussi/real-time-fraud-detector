{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Predictions / sec",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(predictions_total[5m]))",
          "legendFormat": "all"
        },

        {
          "refId": "B",
          "expr": "sum(rate(predictions_total{decision=\"REJECT\"}[5m]))",
          "legendFormat": "rejected"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}},
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p99 Latency (ms)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(prediction_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ms", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 100}]}},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Fraud Rate (rejected share)",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(predictions_total{decision=\"REJECT\"}[5m])) / clamp_min(sum(rate(predictions_total[5m])), 0.001)",
          "legendFormat": "reject share"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.1}]}},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Input Drift Share",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "evidently_drift_share",
          "legendFormat": "drift share"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.15}]}},
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Lake Rows Written / sec",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lake_rows_written_total[5m]))",
          "legendFormat": "rows"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}},
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kafka Consumer Lag",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumer_lag{job=\"lake-consumer\"}",
          "legendFormat": "lake consumer"
        },
        {
          "refId": "B",
          "expr": "kafka_consumer_lag{job=\"kafka-consumer\"}",
          "legendFormat": "prediction consumer"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 5000}]}},
        "overrides": []
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["mlops", "fraud"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "MLOps Overview",
  "uid": "mlops-overview",
  "version": 1
}
