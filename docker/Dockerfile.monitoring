# ── Build stage ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder
WORKDIR /build
COPY requirements/monitoring.txt requirements/monitoring.txt
# Cache the wheels: without it every rebuild re-downloads ~1GB and any PyPI
# hiccup fails the build (the earlier --no-cache-dir defeated the mount).
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 120 --retries 5 --prefix=/install -r requirements/monitoring.txt

# ── Runtime stage ─────────────────────────────────────────────────────────
FROM python:3.11-slim
WORKDIR /app
COPY --from=builder /install /usr/local
COPY monitoring/ monitoring/
COPY config/ config/
COPY db/ db/
COPY datalake/ datalake/
COPY training/ training/
COPY features/ features/
ENV PYTHONPATH=/app
EXPOSE 8001
CMD ["uvicorn", "monitoring.alert_webhook:app", "--host", "0.0.0.0", "--port", "8001"]
